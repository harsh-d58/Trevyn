# Names only. Copy to .env and fill in. Never commit .env.
DATABASE_URL=            # blank = local SQLite (var/trevyn.db). Supabase: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
EVIDENCE_DIR=var/evidence
CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=       # blank = deterministic template planner, no AI diagnosis/chat
MODEL_PLANNER=claude-opus-5-5
MODEL_DIAGNOSTICIAN=claude-opus-5-5
MODEL_FIX=claude-opus-5-5
MODEL_ASSISTANT=claude-opus-5-5
DEMO_SHOP_URL=http://localhost:3100
TREVYN_HOOK_TOKEN=
BUGS=all
# Evidence store (Step 8): all four S3_* set = upload to S3-compatible storage; unset = local files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
EVIDENCE_URL_TTL_S=
# Integrations (Step 11)
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
OPA_URL=

# AI provider: gemini or anthropic (blank keys = deterministic fallbacks)
MODEL_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
