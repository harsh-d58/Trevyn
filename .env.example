# Names only. Copy to .env and fill in. Never commit .env.
DATABASE_URL=            # blank = local SQLite (var/trevyn.db). Supabase app traffic: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
EVIDENCE_DIR=var/evidence
# Per-process Postgres limits. Keep these small even with Supabase transaction
# mode; the API reuses connections instead of resolving the host per request.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
CORS_ORIGINS=http://localhost:3000
# Use the same secret on every API process when AUTH_MODE=supabase so SSE tickets work across processes.
AUTH_MODE=off
SUPABASE_JWKS_URL=
# Use this instead of JWKS only for legacy HS256 Supabase projects.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
TICKET_SECRET=
MANIFEST_SIGNING_KEY=
# Set to 1 on a public Render service; refuses to start without auth, Postgres, Redis, S3, and exact CORS.
TREVYN_PUBLIC_DEPLOY=0
REDIS_URL=
ANTHROPIC_API_KEY=       # blank = deterministic template planner, no AI diagnosis/chat
MODEL_PLANNER=claude-opus-5-5
MODEL_DIAGNOSTICIAN=claude-opus-5-5
MODEL_FIX=claude-opus-5-5
MODEL_ASSISTANT=claude-opus-5-5
DEMO_SHOP_URL=http://localhost:3100
# Optional installed browser channel if Playwright's Chromium bundle is unavailable (chrome or msedge).
PLAYWRIGHT_CHANNEL=
TREVYN_HOOK_TOKEN=
BUGS=all
# Evidence store (Step 8): all four S3_* set = upload to S3-compatible storage; unset = local files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
EVIDENCE_URL_TTL_S=
# Integrations (Step 11)
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
OPA_URL=

# AI provider. One key, many models: an OpenAI-compatible gateway such as OpenRouter.
# Set MODEL_PROVIDER= and paste the key below. Blank key = smoke/template plans + rule-based diagnosis.
MODEL_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# FastRouter instead: MODEL_PROVIDER=fastrouter and LLM_BASE_URL=https://go.fastrouter.ai/api/v1 (same model ids, e.g. anthropic/claude-sonnet-5.5)
# Model per Trevyn task (gateway model ids). Well-known options to swap in:
#   anthropic/claude-sonnet-4 · anthropic/claude-3.5-haiku · openai/gpt-4o · openai/gpt-4o-mini
#   google/gemini-2.5-pro · google/gemini-2.5-flash · meta-llama/llama-3.3-70b-instruct
#   deepseek/deepseek-chat · mistralai/mistral-large · qwen/qwen-2.5-72b-instruct
LLM_MODEL=google/gemini-2.5-flash
LLM_MODEL_PLANNER=anthropic/claude-haiku-5.5
LLM_MODEL_DIAGNOSTICIAN=anthropic/claude-haiku-5.5
LLM_MODEL_FIX=anthropic/claude-haiku-5.5
LLM_MODEL_ASSISTANT=google/gemini-2.5-flash
LLM_MODEL_REPORT=anthropic/claude-haiku-5.5

# ---- Independent quality engines (all optional; a missing tool shows as "not run") ----
# ZAP passive baseline runs in Docker (image zaproxy/zap-stable); it gets its own time budget.
ZAP_MAX_SECONDS=180
# OSV-Scanner / Gitleaks binaries: found on PATH, in var/tools/, or at these paths.
OSV_SCANNER_BIN=
GITLEAKS_BIN=
# Repository scan (checkout + OSV + Gitleaks) budget in seconds.
REPO_SCAN_MAX_SECONDS=180
# Lane budgets in seconds (lanes run in parallel; a run waits for the slowest).
COMPAT_MAX_SECONDS=300
LIGHTHOUSE_MAX_SECONDS=240
