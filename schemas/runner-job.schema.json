{
  "$defs": {
    "Assertion": {
      "properties": {
        "kind": {
          "enum": [
            "ui_text",
            "url",
            "count",
            "network_posts",
            "db_row_count",
            "status"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "lte",
            "gte",
            "contains",
            "matches"
          ],
          "title": "Op",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Expected"
        }
      },
      "required": [
        "kind",
        "subject",
        "op",
        "expected"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Step": {
      "properties": {
        "action": {
          "enum": [
            "goto",
            "click",
            "dblclick",
            "fill",
            "select",
            "press",
            "wait_for",
            "reset"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "hook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hook Url"
        },
        "hook_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hook Token"
        }
      },
      "required": [
        "base_url",
        "allowed_hosts"
      ],
      "title": "Target",
      "type": "object"
    },
    "TestCase": {
      "properties": {
        "test_case_id": {
          "title": "Test Case Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "requirement_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Ref"
        },
        "preconditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected_result": {
          "title": "Expected Result",
          "type": "string"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "side_effects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "risk": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "timeout_budget_s": {
          "default": 90,
          "maximum": 600,
          "title": "Timeout Budget S",
          "type": "integer"
        }
      },
      "required": [
        "test_case_id",
        "title",
        "steps",
        "expected_result",
        "assertions"
      ],
      "title": "TestCase",
      "type": "object"
    }
  },
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "kind": {
      "const": "playwright",
      "default": "playwright",
      "title": "Kind",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "test_cases": {
      "items": {
        "$ref": "#/$defs/TestCase"
      },
      "title": "Test Cases",
      "type": "array"
    },
    "browser": {
      "default": "chromium",
      "title": "Browser",
      "type": "string"
    },
    "headless": {
      "default": true,
      "title": "Headless",
      "type": "boolean"
    },
    "viewport": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Viewport"
    },
    "mobile": {
      "default": false,
      "title": "Mobile",
      "type": "boolean"
    },
    "out_dir": {
      "title": "Out Dir",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "run_id",
    "target",
    "test_cases",
    "out_dir"
  ],
  "title": "RunnerJob",
  "type": "object"
}